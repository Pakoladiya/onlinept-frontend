rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Clinics ──────────────────────────────────────────────────────────
    match /clinics/{clinicId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || request.auth.uid == 'SUPER_ADMIN_UID');
    }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // ── Bookings ───────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.physioId == request.auth.uid
            || resource.data.patientId == request.auth.uid
            || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.physioId == request.auth.uid
            || resource.data.patientId == request.auth.uid
            || resource.data.uid == request.auth.uid);
    }

    // ── Patients ───────────────────────────────────────────────────────
    match /patients/{patientId} {
      allow read: if request.auth != null && resource.data.physioId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.physioId == request.auth.uid;
      allow delete: if false;

      // HEP Subcollection
      match /hep/{hepId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/patients/$(patientId)).data.physioId == request.auth.uid;
        allow write: if request.auth != null && get(/databases/$(database)/documents/patients/$(patientId)).data.physioId == request.auth.uid;
      }
    }

    // ── Blocked Slots ─────────────────────────────────────────────────
    match /blockedSlots/{slotId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ── Clinic Files (Resource Library) ───────────────────────────────
    // Each physio can only read/write their own clinic's files
    match /clinic_files/{fileId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.clinicId is string
        && exists(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId))
        && get(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)).data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.clinicId is string
        && get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.clinicId is string
        && get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.uid == request.auth.uid;
    }

    // ── Sessions Subcollection (on bookings) ─────────────────────────
    // Stores SOAP notes, VAS, HEP, feedback per booking
    match /bookings/{bookingId}/sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Bundles ────────────────────────────────────────────────────────
    match /bundles/{bundleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.clinicId is string
        && request.resource.data.clinicId != 'platform'
        && get(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)).data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.clinicId is string
        && resource.data.clinicId != 'platform'
        && get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.uid == request.auth.uid;
    }

    // ── Clinic Presets (Branding) ──────────────────────────────────────
    match /clinic_presets/{clinicId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/clinics/$(clinicId)).data.uid == request.auth.uid;
    }

    // ── Message Templates ──────────────────────────────────────────────
    match /message_templates/{templateId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.resource.data.clinicId is string
        && get(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)).data.uid == request.auth.uid;
    }

    // ── Subscriptions ──────────────────────────────────────────────────
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == 'SUPER_ADMIN_UID';
    }
  }
}