# ============================================================
# Backend Environment Variables (backend/.env)
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to GitHub.
# ============================================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK
# Found in: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Zoom Server-to-Server OAuth
# Found in: Zoom Marketplace → Develop → Build App → Server-to-Server OAuth
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# WhatsApp Business Cloud API
# Found in: Meta for Developers → WhatsApp → Your App → API Setup
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_ADMIN_TOKEN=your_facebook_whatsapp_access_token

# Airpay Payment Gateway
# Found in: Airpay Merchant Dashboard → Settings → API Credentials
# Leave all blank to run in mock/test mode (no real payments processed)
AIRPAY_MERCHANT_ID=your_airpay_merchant_id
AIRPAY_SECRET_KEY=your_airpay_secret_key
AIRPAY_USERNAME=your_airpay_username
AIRPAY_PASSWORD=your_airpay_password
AIRPAY_GATEWAY_URL=https://payments.airpay.co.in/pay/index.php
